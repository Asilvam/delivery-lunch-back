# Copiar a .env y reemplazar los valores de ejemplo.
# .env.local tiene prioridad sobre .env. No subir credenciales reales al repositorio.

# Entorno y puerto HTTP
NODE_ENV=development
PORT=3500

# Los pedidos usan transacciones: se requiere un replica set (rs0 en local).
# Para una demo aislada sin instalar MongoDB: npm run start:local.
# MongoDB (obligatorio). Para Atlas, usar la URI de conexión del clúster.
MONGODB_URI=mongodb://127.0.0.1:27017/delivery_lunch?replicaSet=rs0
# Nombre de base de datos opcional; si se omite, se usa el de la URI.
MONGODB_DB_NAME=delivery_lunch

# JWT (secret obligatorio). Reemplazar por un valor aleatorio y privado.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Administrador (obligatorio). PASSWORD_HASH debe ser un hash bcrypt,
# nunca la contraseña en texto plano.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# Cuenta de cocina opcional. Configurar ambos valores para habilitarla.
KITCHEN_USERNAME=
KITCHEN_PASSWORD_HASH=

# Cloudinary (obligatorio para iniciar UploadModule).
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# WhatsApp mediante CallMeBot (opcional).
# Dejar ambos valores vacíos para omitir notificaciones.
# Usar un número autorizado en formato internacional, solo dígitos
# (ejemplo ficticio de formato: 56900000000), y su API key asociada.
WHATSAPP_NOTIFY_PHONE=
CALLMEBOT_API_KEY=

# Autenticación de clientes con Google. Nunca exponer el client secret en el frontend.
GOOGLE_CLIENT_ID=replace_with_google_client_id
# El client secret no se usa para verificar ID tokens en este flujo.
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Orígenes exactos autorizados para la sesión recordada de clientes (separados por coma).
# Producción: https://sabores.serviciosasm.cl. Se usa /api/auth en el mismo dominio.
CUSTOMER_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
